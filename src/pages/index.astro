---
import { sanityClient, urlFor } from '../lib/sanity';

let settings = null;
let home = null;

try {
  settings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
  home = await sanityClient.fetch(`*[_type == "pageHome"][0]{
    ...,
    "polaroidUrl": heroPolaroid.asset->url,
    "backdropUrl": heroBackdrop.asset->url,
    "videoUrl": showcaseVideo.asset->url,
    "introImageUrl": introImage.asset->url,
    galleryPhotos[]{
      title,
      "asset": asset->
    }
  }`);
} catch (e) {
  console.error("Sanity fetch error (falling back to static defaults):", e);
}

// Fallback values in case Sanity document isn't published yet
const siteTitle = settings?.title || 'DG PHOTOGRAPHY';
const contactEmail = settings?.contactEmail || 'studio@portfolio.art';
const contactPhone = settings?.contactPhone || '+389 72 303 764';
const instagramUrl = settings?.instagramUrl || 'https://www.instagram.com/d_gorgiev_photo/';

const heroTitle = home?.heroTitle || 'Dario Gorgiev';
const heroSubtitle = home?.heroSubtitle || 'PHOTOGRAPHY';
const heroDesc = home?.heroDescription || 'A personal portfolio showcasing my selected works.';
const heroPolaroid = home?.polaroidUrl || '/images/portrait.jpg';
const heroBackdrop = home?.backdropUrl || '/images/hero.jpg';

const showcaseHeading = home?.showcaseHeading || 'Cinematic perspectives from the field';
const showcaseCaption = home?.showcaseCaption || 'A short visual reel capturing the atmosphere and tone of my recent analog work.';
const showcaseVideo = home?.videoUrl || '/images/video.mp4';

const introHeading = home?.introHeading || 'Today I am presenting my curated portfolio, a collection of moments frozen in time.';
const introImageUrl = home?.introImageUrl || '/images/portrait.jpg';
const introCaption = home?.introImageCaption || "The photographer's camera, always ready for the next shot.";
const introText1 = home?.introText1 || 'Photography is more than just pressing a button; it is the art of seeing and preserving atmosphere. Every frame in this collection represents patience—waiting for the perfect light, the subtle gesture, and the quiet harmony between subject and space. Rather than a flat sequence of pictures, these series capture the tactile weight of each environment and moment.';
const introText2 = home?.introText2 || 'Rooted in analog disciplines and refined through digital precision, each study explores texture, depth, and shadow. A single shutter release condenses natural light, genuine emotion, and the stillness of time into an enduring visual narrative.';

const galleryHeading = home?.galleryHeading || 'Selected Works & Studies';
const galleryDesc = home?.galleryDescription || 'Every photo holds a story. Explore selected captures spanning natural landscapes, architecture, and fleeting moments from recent series.';
const galleryPhotos = home?.galleryPhotos || [
  { src: '/images/photo-1.jpg', title: 'Frost & Fern' },
  { src: '/images/photo-2.jpg', title: 'Mountain Pass' },
  { src: '/images/photo-3.jpg', title: 'Urban Symmetry' },
  { src: '/images/photo-4.jpg', title: 'Morning Light' },
  { src: '/images/photo-5.jpg', title: 'The Red Cabin' },
  { src: '/images/photo-6.jpg', title: 'Coastal Waves' }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{siteTitle}</title>
    <link rel="stylesheet" href="/style.css?v=20">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Instrument+Sans:wght@400..650&display=swap" rel="stylesheet">
</head>
<body class="loading-state">
    <!-- SVG Filter for torn paper edge -->
    <svg width="0" height="0" style="position: absolute; pointer-events: none;">
        <filter id="torn-edge" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <header id="navbar">
        <a href="#" class="logo" id="logo-link">
            <span class="logo-icon"></span>
            {siteTitle}
        </a>
        <button class="mobile-menu-btn" aria-label="Toggle Menu">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <nav id="nav-links">
            <a href="#showcase">Showcase</a>
            <a href="#introduction">Introduction</a>
            <a href="#gallery">Gallery</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <!-- Intro Hero Section -->
        <section id="hero-intro">
            <div class="hero-panels-container">
                <div class="panel panel-left torn-edges-mask" data-bg="/images/photo-1.jpg"></div>
                <div class="panel panel-center">
                    <div class="horizon-bg" style={`background-image: url('${heroBackdrop}');`}></div>
                    <div class="polaroid-wrapper">
                        <div class="polaroid-drop">
                            <div class="polaroid-frame">
                                <img src={heroPolaroid} alt="Hero Polaroid">
                            </div>
                        </div>
                    </div>
                    <div class="main-title-container">
                        <h1 class="main-title">{heroTitle}</h1>
                        <h3>{heroSubtitle}</h3>
                        <p class="subtitle">{heroDesc}</p>
                        <div class="toc">
                            <a href="#showcase" class="toc-item"><span class="toc-num">01</span><span class="line"></span><span class="toc-name">Showcase</span></a>
                            <a href="#introduction" class="toc-item"><span class="toc-num">02</span><span class="line"></span><span class="toc-name">Introduction</span></a>
                            <a href="#gallery" class="toc-item"><span class="toc-num">03</span><span class="line"></span><span class="toc-name">Gallery</span></a>
                            <a href="#contact" class="toc-item"><span class="toc-num">04</span><span class="line"></span><span class="toc-name">Contact</span></a>
                        </div>
                    </div>
                </div>
                <div class="panel panel-right torn-edges-mask" data-bg="/images/photo-1.jpg"></div>
            </div>
            <div class="scroll-down">
                <div class="scroll-down-inner">↓ Scroll down ↓</div>
            </div>
        </section>

        <!-- Section 2: Showcase (Video) -->
        <section id="showcase" class="section-dark" data-torn-top="#0b0b0b">
            <div class="featured-content">
                <p class="eyebrow">SHOWCASE</p>
                <h2>{showcaseHeading}</h2>
                <div class="torn-frame">
                    <div class="torn-content">
                        <video id="featured-video" src={showcaseVideo} autoplay muted loop playsinline class="showcase-video"></video>
                        <button class="mute-btn" id="mute-toggle" aria-label="Toggle sound">
                            <svg class="icon-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
                            <svg class="icon-unmute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                        </button>
                    </div>
                </div>
                <p class="caption">{showcaseCaption}</p>
            </div>
        </section>

        <!-- Section 3: Introduction -->
        <section id="introduction" class="section-light" data-torn-top="#f4efeb">
            <div class="container">
                <p class="section-num">INTRODUCTION</p>
                <h2>{introHeading}</h2>
                <div class="intro-layout">
                    <div class="intro-left">
                        <div class="torn-frame-inline">
                            <div class="torn-content">
                                <img src={introImageUrl} alt="Introduction Image">
                            </div>
                        </div>
                        <p class="caption-small">{introCaption}</p>
                    </div>
                    <div class="intro-right">
                        <p>{introText1}</p>
                        <p>{introText2}</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 4: Gallery -->
        <section id="gallery" class="section-light">
            <div class="container">
                <p class="section-num">GALLERY</p>
                <h2>{galleryHeading}</h2>
                <p class="intro-p">{galleryDesc}</p>
                
                <div class="gallery-grid">
                    {home?.galleryPhotos ? (
                        galleryPhotos.map((photo) => (
                            <div class="gallery-item">
                                <div class="torn-content"><img src={urlFor(photo.asset).width(1200).url()} alt={photo.title || "Gallery"} /><div class="view-overlay-btn frosted-glass">VIEW</div></div>
                                <p class="gallery-caption">{photo.title}</p>
                            </div>
                        ))
                    ) : (
                        galleryPhotos.map((photo) => (
                            <div class="gallery-item">
                                <div class="torn-content"><img src={photo.src} alt={photo.title} /><div class="view-overlay-btn frosted-glass">VIEW</div></div>
                                <p class="gallery-caption">{photo.title}</p>
                            </div>
                        ))
                    )}
                </div>
                
                <div class="view-all-container">
                    <a href="/gallery" class="btn-primary">View Full Collection</a>
                </div>
            </div>
        </section>

        <!-- Section 5: Contact / Footer -->
        <footer id="contact" class="section-dark footer-section footer-compact" data-torn-top="#0b0b0b">
            <div class="container footer-compact-container">
                <div class="footer-left">
                    <span class="footer-label">Contact</span>
                    <a href={`mailto:${contactEmail}`} class="footer-link">{contactEmail}</a>
                    <span class="footer-phone">{contactPhone}</span>
                </div>
                <div class="footer-right">
                    <span class="footer-label">Social</span>
                    <div class="footer-social-links">
                        <a href={instagramUrl} target="_blank" rel="noopener" class="footer-link">Instagram <span>↗</span></a>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    <!-- Lightbox Overlay -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
        <button class="lightbox-close frosted-glass" aria-label="Close" id="lightbox-close-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
        <div class="lightbox-content">
            <div class="lightbox-torn-content" id="lightbox-torn-content">
                <img src="" alt="Fullscreen Image" id="lightbox-img" />
            </div>
        </div>
    </div>

    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script is:inline src="/assets/torn.js"></script>
    <script is:inline src="/script.js?v=14"></script>
</body>
</html>
